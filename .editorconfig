root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Swift / Kotlin / Gradle Kotlin DSL — 4 spaces, matching existing sources.
[*.{swift,kt,kts,java,gradle,pro}]
indent_size = 4

# Xcode and Android Studio both emit 4-space XML; keep it that way to avoid churn.
[*.{xml,storyboard,xib}]
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

# Trailing whitespace is significant in Markdown (hard line breaks).
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Xcode regenerates these with tabs; do not fight it.
[*.{pbxproj,plist}]
indent_style = tab

[Makefile]
indent_style = tab
